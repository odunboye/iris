package iris

authors    = "Odun Adeboye"
version    = 0.4.0
brief      = "Iris — cross-platform declarative UI for Idris 2"

depends    = contrib

sourcedir  = "src"

modules =
  -- Universal widget + app
    Iris.Widget
  , Iris.App
  , Iris.App.Events
  , Iris.App.EventWire

  -- Internal types and legacy Core.Widget/Core.Runtime (not application APIs)
  , Iris.Core.Types
  , Iris.Core.Widget
  , Iris.Core.VTree
  , Iris.Core.Runtime
  , Iris.Runtime.Common

  -- State
  , Iris.Effect.Command
  , Iris.State.TEA
  , Iris.State.Signal

  -- Layout
  , Iris.Layout.Types

  -- Render IR
  , Iris.Render.Types

  -- Effects
  , Iris.Effect.Http
  , Iris.Effect.Http.Web
  , Iris.Effect.Keyboard

  -- Platform events; Interface is an experimental PAL
  , Iris.Platform.Event
  , Iris.Platform.Interface

  -- Animation
  , Iris.Animation.Types

  -- Theme
  , Iris.Theme.Types
  , Iris.Theme.Default

  -- Router
  , Iris.Router.Types
  , Iris.Router.Web

  -- Specialized DOM/Canvas runners; Web.DOM, SDL2 and framebuffer are experimental
  , Iris.Backend.Canvas.Render
  , Iris.Backend.Canvas.Layout
  , Iris.Backend.Canvas.Run
  , Iris.Backend.Web.DOM
  , Iris.Backend.Web.Terminal
  , Iris.Backend.Web.Control
  , Iris.Backend.Web.DOM.Render
  , Iris.Backend.Web.DOM.Run
  , Iris.Backend.Desktop.SDL2
  , Iris.Backend.Embedded.Framebuffer

  -- TUI Backend
  , Iris.Backend.Terminal.WidgetRender
  , Iris.Backend.Terminal.Run
  , Iris.Backend.Terminal.Types
  , Iris.Backend.Terminal.ANSI
  , Iris.Backend.Terminal.Diff
  , Iris.Backend.Terminal.Input
  , Iris.Backend.Terminal.Runtime
  , Iris.Backend.Terminal.FFI
  , Iris.Backend.Terminal.Renderer
  , Iris.Backend.Terminal.App

  -- TUI Core
  , Iris.Widget.TUI.Core

  -- Terminal-specific compatibility widgets (portable apps use Iris.Widget)
  , Iris.Widget.TUI.Primitives
  , Iris.Widget.TUI.List
  , Iris.Widget.TUI.Table
  , Iris.Widget.TUI.Progress
  , Iris.Widget.TUI.Input
  , Iris.Widget.TUI.Chart
  , Iris.Widget.TUI.Scroll
  , Iris
