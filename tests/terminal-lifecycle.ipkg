package iris-terminal-lifecycle
depends = iris
sourcedir = "."
modules = TerminalLifecycle
main = TerminalLifecycle
executable = terminal-lifecycle
prebuild = "mkdir -p build/exec/terminal-lifecycle_app && cc -dynamiclib ../c/iristui.c -o build/exec/terminal-lifecycle_app/libiristui.dylib 2>/dev/null || cc -shared -fPIC ../c/iristui.c -o build/exec/terminal-lifecycle_app/libiristui.so"
